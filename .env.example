# ==============================================================================
# GreenPay — Root Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the repository root or set these variables
# in your deployment platform (e.g. Render, Railway, AWS).
# ==============================================================================

# 1. Environment & Mode (development | staging | production)
ENV=development

# 2. Database Connection
# SQLite (development only): sqlite:///./greenpay.db
# PostgreSQL (production on Render): postgresql://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=sqlite:///./greenpay.db

# 3. Cryptography & Security Secrets (Generate using: openssl rand -hex 32)
SECRET_KEY=replace_with_a_securely_generated_64_character_hex_string
METER_ENCRYPTION_KEY=replace_with_a_secure_32_character_aes_encryption_key!
CSRF_SECRET=replace_with_a_securely_generated_csrf_secret_string

# 4. CORS Origins (Include frontend URLs)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# 5. Cookie Security (Set to true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# 6. Email Service (Optional for development, uses console mail-catcher)
ENABLE_PRODUCTION_EMAIL=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@greenpay.org.in

# 7. SMS Service (Optional for development, uses console OTP logger)
ENABLE_PRODUCTION_SMS=false
SMS_GATEWAY_URL=
SMS_ENTITY_ID=
SMS_HEADER=
SMS_API_KEY=

# 8. Mandatory Business Entity Configuration (DPDP Act 2023)
BUSINESS_LEGAL_NAME=
BUSINESS_REGISTERED_ADDRESS=
BUSINESS_CONTACT_EMAIL=
BUSINESS_CONTACT_PHONE=
BUSINESS_GRIEVANCE_OFFICER_NAME=
BUSINESS_GRIEVANCE_OFFICER_EMAIL=
BUSINESS_CIN=
