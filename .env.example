# ==============================================================================
# GreenPay Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS: Copy this file to .env and supply your environment-specific values.
# In production (ENV=production), the API refuses to boot if default passwords or
# demo seed accounts are detected (Amendment #11).
# ==============================================================================

# Application Environment (development | staging | production)
ENV=development

# Database Connection
# SQLite (development): sqlite:///./greenpay.db
# PostgreSQL (production/staging): postgresql://user:password@localhost:5432/greenpay_db
DATABASE_URL=sqlite:///./greenpay.db

# Security & Cryptography Secrets (Generate with `openssl rand -hex 32`)
SECRET_KEY=change_me_to_a_random_32_byte_hex_string_for_production_jwt
ENCRYPTION_KEY=32_chars_exact_aes256_key_1234
HMAC_SECRET=change_me_to_a_random_hmac_key_for_meter_blind_indexing

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Cookie Domain & Security
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# SMTP & Notification Dispatcher (Local mailcatcher on port 1025 in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@greenpay.org.in

# ==============================================================================
# Mandatory Business Entity Configuration (Amendment #1)
# ==============================================================================
# WARNING: Do NOT invent fake company names, dummy CINs, or placeholders.
# Leave these blank until you have real corporate/entity records.
# The strict build validator (`npm run validate:business-config`) will purposefully
# fail the build until real non-placeholder values are supplied.
# ==============================================================================
BUSINESS_LEGAL_NAME=
BUSINESS_REGISTERED_ADDRESS=
BUSINESS_CONTACT_EMAIL=
BUSINESS_CONTACT_PHONE=
BUSINESS_GRIEVANCE_OFFICER_NAME=
BUSINESS_GRIEVANCE_OFFICER_EMAIL=
BUSINESS_CIN=
