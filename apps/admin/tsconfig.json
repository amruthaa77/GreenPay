{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@greenpay/tokens": ["../../packages/tokens/index.ts"],
      "@greenpay/config": ["../../packages/config/business.config.ts"]
    }
  },
  "include": [
    "src",
    "../../packages/tokens/index.ts",
    "../../packages/config/business.config.ts",
    "../../packages/config/validate-business-config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts"
  ]
}
