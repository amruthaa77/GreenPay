# ==============================================================================
# GreenPay API (FastAPI Backend) — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` inside `apps/api/` (or set these in your hosting environment, e.g., Render).
# 2. Never commit actual secret keys or your `.env` file to version control.
# 3. In production (`ENV=production`), the backend will verify that all required secrets
#    and encryption keys are set and that zero demo seed accounts or default passwords exist.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Mode
# ------------------------------------------------------------------------------
# Mandatory: YES
# Options: development | staging | production
# NOTE: Setting ENV=production enforces strict security guards:
#       - Refuses to boot if demo meters or default passwords exist in the database (Amendment #11).
#       - Activates HTTP Strict Transport Security (HSTS) headers.
ENV=development

# Optional (Defaults provided in code)
PROJECT_NAME="GreenPay"
VERSION="1.0.0"
API_V1_STR="/api/v1"


# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Mandatory: YES
# Development (SQLite):
#   sqlite:///./greenpay.db
# Production (Render / PostgreSQL):
#   postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>
# IMPORTANT:
#   SQLite is NOT safe for production on Render because Render containers use
#   an ephemeral filesystem (data is lost on restart/redeploy) and SQLite suffers
#   from file-lock contention under concurrent supervisor collections.
DATABASE_URL=sqlite:///./greenpay.db


# ------------------------------------------------------------------------------
# 3. Cryptography, Tokens & Security Secrets
# ------------------------------------------------------------------------------
# Mandatory: YES (Must be generated securely using high-entropy random generators)
# Generate each value using: openssl rand -hex 32  OR  python -c "import secrets; print(secrets.token_hex(32))"

# Secret key for JWT access/refresh token signing and HMAC meter blind-indexing:
SECRET_KEY=replace_with_a_securely_generated_64_character_hex_string

# Symmetric encryption key for AES-256 encryption of electricity meter numbers at rest (DPDP Act compliance):
# Must be 32 characters or a 32-byte url-safe base64 string:
METER_ENCRYPTION_KEY=replace_with_a_secure_32_character_aes_encryption_key!

# Secret key used for double-submit cookie CSRF validation:
CSRF_SECRET=replace_with_a_securely_generated_csrf_secret_string

# Token lifetimes (Optional, defaults provided):
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# ------------------------------------------------------------------------------
# 4. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Mandatory: YES in production
# JSON list or comma-separated origins allowed to make authenticated requests.
# Include both Citizen Web and Super Admin Portal URLs:
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","https://your-citizen-web.onrender.com","https://your-admin-portal.onrender.com"]


# ------------------------------------------------------------------------------
# 5. Cookie Security & Session Scopes
# ------------------------------------------------------------------------------
# Mandatory: YES in production
# Set to 'true' in production so cookies are transmitted ONLY over HTTPS.
COOKIE_SECURE=false

# SameSite cookie policy (lax | strict | none).
# Use 'lax' if frontend and API share the same root domain.
# Use 'none' (with COOKIE_SECURE=true) if frontend and API are hosted on different domains.
COOKIE_SAMESITE=lax

# Separate cookie names for Citizen vs Admin sessions (Optional, defaults provided):
CITIZEN_ACCESS_COOKIE=gp_citizen_access
CITIZEN_REFRESH_COOKIE=gp_citizen_refresh
CITIZEN_CSRF_COOKIE=gp_citizen_csrf

ADMIN_ACCESS_COOKIE=gp_admin_access
ADMIN_REFRESH_COOKIE=gp_admin_refresh
ADMIN_CSRF_COOKIE=gp_admin_csrf


# ------------------------------------------------------------------------------
# 6. Email Service (Transactional Notifications & Password Resets)
# ------------------------------------------------------------------------------
# Mandatory: NO (Can be configured later)
# If ENABLE_PRODUCTION_EMAIL=false, the system automatically uses ConsoleEmailAdapter
# (emails are logged to server console without crashing).
ENABLE_PRODUCTION_EMAIL=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=replace_with_smtp_password_or_api_key
SMTP_FROM=no-reply@greenpay.org.in


# ------------------------------------------------------------------------------
# 7. SMS Service (Indian Telecom DLT-Compliant OTP Dispatch)
# ------------------------------------------------------------------------------
# Mandatory: NO (Can be configured later)
# If ENABLE_PRODUCTION_SMS=false, the system automatically uses ConsoleSMSAdapter
# (OTPs are logged to server console for local testing without leaking to API).
# In production, requires registration on Indian Telecom DLT portal (TRAI mandate).
ENABLE_PRODUCTION_SMS=false
SMS_GATEWAY_URL=https://api.your-dlt-gateway.com/v1/sms
SMS_ENTITY_ID=replace_with_19_digit_dlt_principal_entity_id
SMS_HEADER=GRNPAY
SMS_API_KEY=replace_with_dlt_gateway_api_key


# ------------------------------------------------------------------------------
# 8. Mandatory Business & Legal Entity Configuration (DPDP Act / IT Act)
# ------------------------------------------------------------------------------
# Mandatory: YES for production deployment / build validation
# In compliance with user instructions and Indian DPDP Act 2023:
# Real corporate entity information is required for production legal terms and privacy disclosures.
BUSINESS_LEGAL_NAME=
BUSINESS_REGISTERED_ADDRESS=
BUSINESS_CONTACT_EMAIL=
BUSINESS_CONTACT_PHONE=
BUSINESS_GRIEVANCE_OFFICER_NAME=
BUSINESS_GRIEVANCE_OFFICER_EMAIL=
BUSINESS_CIN=
