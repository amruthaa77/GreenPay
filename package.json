{
  "name": "greenpay-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "validate:business-config": "tsx packages/config/validate-business-config.ts",
    "test:tokens": "tsx packages/tokens/contrast.test.ts",
    "build:web": "npm --workspace=apps/web run build",
    "build:admin": "npm --workspace=apps/admin run build",
    "build": "npm run validate:business-config && npm run build:web && npm run build:admin",
    "optimize:assets": "node scripts/compress-images.js",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:admin": "npm --workspace=apps/admin run dev",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
